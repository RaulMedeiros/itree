# URL da API. Vazio = mesma origem (o Vite faz proxy de /api em desenvolvimento).
VITE_API_URL=
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/itree
VITE_OIDC_CLIENT_ID=itree-web
# Exibe módulos de fases ainda não entregues como "em construção" (nunca em produção).
VITE_MOSTRAR_MODULOS_FUTUROS=true
# Mapa base de satélite. Sem VITE_MAPA_SATELITE_URL, a opção "Satélite" não aparece.
# Padrão de desenvolvimento e demonstração: Sentinel-2 cloudless 2016 (EOX), CC BY 4.0, 10 m.
# O provedor de produção, com imagem de alta resolução, depende da DP-21.
VITE_MAPA_SATELITE_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless_3857/default/g/{z}/{y}/{x}.jpg
VITE_MAPA_SATELITE_NOME=Sentinel-2 cloudless 2016 (EOX)
VITE_MAPA_SATELITE_ATRIBUICAO=Sentinel-2 cloudless – https://s2maps.eu by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2016)
VITE_MAPA_SATELITE_ZOOM_MAXIMO=14
VITE_MAPA_SATELITE_DATA=2016-12-31
VITE_MAPA_SATELITE_AVISO=imagem de 10 m: mostra manchas de vegetação, não árvores individuais
